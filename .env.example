# ============================================
# LabLink AI - Environment Variables
# ============================================
# Copy this file to .env and update values for your environment
# cp .env.example .env
#
# SECURITY WARNING: Never commit .env to version control!
# The .env file should be in .gitignore

# ----------------------------------------
# API Configuration
# ----------------------------------------

# API server settings
API_HOST=0.0.0.0
API_PORT=8000

# Logging configuration
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable JSON-formatted logs for production
# Set to 'false' for human-readable logs in development
JSON_LOGS=true

# ----------------------------------------
# PostgreSQL Database
# ----------------------------------------

# Database connection settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lablink
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# For production, use a strong password:
# POSTGRES_PASSWORD=<generate-secure-password-here>

# Full connection URL (alternative to individual settings)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/lablink

# ----------------------------------------
# S3/MinIO Storage
# ----------------------------------------

# S3-compatible storage endpoint
# For MinIO (local): http://minio:9000
# For AWS S3: https://s3.us-east-1.amazonaws.com
S3_ENDPOINT=http://minio:9000

# AWS region (required for S3, can be any value for MinIO)
S3_REGION=us-east-1

# Access credentials
# For MinIO: use the root user credentials
# For AWS: use IAM user credentials or instance role
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Bucket name for storing uploaded files
S3_BUCKET=lablink

# Use HTTPS for S3 connections
# Set to 'true' for AWS S3, 'false' for local MinIO
S3_SECURE=false

# ----------------------------------------
# Edge Agent Configuration (Optional)
# ----------------------------------------

# API endpoint for edge agent to connect to
# EDGE_API_BASE=http://localhost:8000

# Organization ID for the edge agent
# EDGE_ORG_ID=demo-lab

# Folder to watch for new files
# EDGE_WATCH_FOLDER=/path/to/watch

# Maximum retry attempts for failed uploads
# EDGE_MAX_RETRIES=3

# Maximum failures before moving to dead letter queue
# EDGE_MAX_FAILURES=5

# ----------------------------------------
# Security Settings (Production)
# ----------------------------------------

# Secret key for signing (generate a secure random string)
# SECRET_KEY=<generate-with-openssl-rand-hex-32>

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=https://your-frontend.com

# API rate limiting (requests per minute)
# RATE_LIMIT=100

# ----------------------------------------
# Webhook Settings
# ----------------------------------------

# Default timeout for webhook requests (seconds)
# WEBHOOK_TIMEOUT=10

# Maximum retry attempts for failed webhooks
# WEBHOOK_MAX_RETRIES=3

# Disable webhooks after N consecutive failures
# WEBHOOK_DISABLE_AFTER_FAILURES=10

# ----------------------------------------
# Feature Flags
# ----------------------------------------

# Enable debug mode (shows detailed errors, not for production!)
# DEBUG=false

# Enable API documentation endpoints (/docs, /redoc)
# ENABLE_DOCS=true

# Enable audit logging
# ENABLE_AUDIT=true

# ----------------------------------------
# Monitoring (Optional)
# ----------------------------------------

# Sentry DSN for error tracking
# SENTRY_DSN=https://xxx@sentry.io/xxx

# OpenTelemetry endpoint for tracing
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# ----------------------------------------
# Cloud-Specific Settings (for AWS deployment)
# ----------------------------------------

# Use IAM role for S3 access instead of access keys
# AWS_USE_IAM_ROLE=true

# RDS settings (when using AWS RDS instead of local Postgres)
# RDS_HOSTNAME=your-rds-instance.region.rds.amazonaws.com
# RDS_PORT=5432
